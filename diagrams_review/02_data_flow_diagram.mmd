flowchart LR
    subgraph External["External Entity"]
        Recruiter[Recruiter/Admin]
    end

    subgraph Flask["Flask Web Application"]
        Auth[Register/Login/Logout Routes]
        JobRoutes[Job Create/Delete Routes]
        UploadRoute[Upload Route]
        Dashboard[Dashboard Route]
        StatusRoute[Candidate Status Route]
        ReportRoute[Selected PDF Report Route]
    end

    subgraph Processing["Processing Modules"]
        Parser[utils/parser.py]
        Preprocess[utils/preprocess.py]
        Skills[utils/skills.py]
        Matcher[ai/matcher.py]
        Ranking[ai/ranking.py]
        Analytics[ai/analytics.py]
    end

    subgraph Storage["Local Storage"]
        Uploads[(uploads folder)]
        DB[(SQLite database.db)]
        Model[(Cached all-MiniLM-L6-v2 model)]
    end

    Recruiter -->|username/password| Auth
    Auth -->|user session| Dashboard
    Recruiter -->|title, description, required skills| JobRoutes
    JobRoutes --> DB
    Recruiter -->|PDF/DOCX resumes| UploadRoute
    UploadRoute --> Uploads
    UploadRoute --> Parser
    Parser -->|raw text, sections, contact| Preprocess
    Preprocess --> Skills
    Skills --> Matcher
    Model --> Matcher
    Matcher --> Ranking
    Ranking --> DB
    DB --> Analytics
    Analytics --> Dashboard
    Dashboard -->|ranked table, cards, charts| Recruiter
    Recruiter -->|Shortlisted/Rejected/Pending| StatusRoute
    StatusRoute --> DB
    Recruiter -->|download request| ReportRoute
    DB --> ReportRoute
    ReportRoute -->|shortlisted PDF| Recruiter
